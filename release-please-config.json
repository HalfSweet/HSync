{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "pull-request-title-pattern": "chore: release${component} ${version}",
  "pull-request-header": "Merging this pull request tags the release, builds the installers into a draft release and publishes it (DESIGN.md §11.5).",
  "bump-minor-pre-major": true,
  "initial-version": "0.1.0",
  "draft": true,
  "force-tag-creation": true,
  "packages": {
    ".": {
      "package-name": "hsync",
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(!@.source)].version" }
      ]
    }
  }
}
