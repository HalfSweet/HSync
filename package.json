{
  "name": "hsync",
  "version": "0.2.7",
  "private": true,
  "description": "A modern, general-purpose logic analyzer app for DSLogic, ATK-Logic, PX-Logic and SLogic devices, built with Tauri, Vue and Rust.",
  "license": "(Apache-2.0 OR GPL-3.0-or-later)",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "bundle": "node scripts/bundle.mjs",
    "release": "node scripts/release.mjs",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.mjs",
    "typecheck": "vue-tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm dsl:compile && vitest run",
    "test:watch": "pnpm dsl:compile && vitest",
    "bindings": "pnpm dsl:generate && cargo test --workspace export_bindings",
    "dsl:compile": "node --experimental-strip-types uiharu/compiler/src/main.ts",
    "dsl:generate": "pnpm dsl:compile && cargo run --locked -p uiharu-codegen -- uiharu/dsl/ir uiharu/crates/uiharu-dsl-protocols/src/generated && cargo run --locked -p uiharu-codegen -- uiharu/crates/uiharu-interp/tests/fixtures/backend/ir uiharu/crates/uiharu-interp/tests/fixtures/backend/generated",
    "dsl:check": "pnpm dsl:generate && cargo check --locked -p uiharu-dsl-protocols -p uiharu-interp --all-targets"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "git-cliff": "^2.14.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "lefthook": "^2.2.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lucide/vue": "^1.54.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.2",
    "@vueuse/core": "^15.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13"
  }
}
