{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HSync",
  "version": "../package.json",
  "identifier": "io.github.halfsweet.hsync",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HSync",
        "width": 1440,
        "height": 900,
        "minWidth": 640,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Logic analyzer host application",
    "longDescription": "HSync is a modern logic analyzer host application compatible with DreamSourceLab DSLogic devices and DSView capture files.",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3"
    },
    "resources": {
      "resources/demo/": "demo/",
      "resources/firmware/": "firmware/"
    }
  }
}
