{
  "ir": 1,
  "name": "ps2",
  "types": [
    {
      "name": "Direction",
      "type": "enum",
      "variants": ["device-to-host", "host-to-device"]
    },
    {
      "name": "ErrorReason",
      "type": "enum",
      "variants": ["start", "aborted"]
    },
    {
      "name": "Ps2Event",
      "type": "union",
      "variants": [
        {
          "name": "frame",
          "fields": [
            {
              "name": "direction",
              "type": "Direction"
            },
            {
              "name": "value",
              "type": "u8"
            },
            {
              "name": "parityOk",
              "type": "bool"
            },
            {
              "name": "stopOk",
              "type": "bool"
            },
            {
              "name": "ack",
              "type": {
                "option": "bool"
              }
            }
          ]
        },
        {
          "name": "error",
          "fields": [
            {
              "name": "reason",
              "type": "ErrorReason"
            }
          ]
        }
      ]
    }
  ],
  "contracts": [
    {
      "schema": {
        "name": "ps2.events",
        "version": 1
      },
      "event": "Ps2Event",
      "roles": {
        "frame": {
          "role": "data",
          "errorWhen": [
            {
              "parityOk": false
            },
            {
              "stopOk": false
            },
            {
              "ack": false
            }
          ]
        },
        "error": {
          "role": "framing"
        }
      }
    }
  ]
}
