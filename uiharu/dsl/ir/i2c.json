{
  "ir": 1,
  "name": "i2c",
  "types": [
    {
      "name": "EndReason",
      "type": "enum",
      "variants": ["stop", "restart", "aborted"]
    },
    {
      "name": "I2cEvent",
      "type": "union",
      "variants": [
        {
          "name": "begin",
          "fields": [
            {
              "name": "tx",
              "type": "u64"
            },
            {
              "name": "partial",
              "type": "bool"
            }
          ]
        },
        {
          "name": "address",
          "fields": [
            {
              "name": "tx",
              "type": "u64"
            },
            {
              "name": "address",
              "type": "u16"
            },
            {
              "name": "tenBit",
              "type": "bool"
            },
            {
              "name": "read",
              "type": "bool"
            },
            {
              "name": "ack",
              "type": "bool"
            }
          ]
        },
        {
          "name": "data",
          "fields": [
            {
              "name": "tx",
              "type": "u64"
            },
            {
              "name": "byte",
              "type": "u8"
            },
            {
              "name": "ack",
              "type": "bool"
            }
          ]
        },
        {
          "name": "restart",
          "fields": [
            {
              "name": "tx",
              "type": "u64"
            },
            {
              "name": "droppedBits",
              "type": "u8"
            }
          ]
        },
        {
          "name": "end",
          "fields": [
            {
              "name": "tx",
              "type": "u64"
            },
            {
              "name": "reason",
              "type": "EndReason"
            },
            {
              "name": "droppedBits",
              "type": "u8"
            }
          ]
        }
      ]
    }
  ],
  "contracts": [
    {
      "schema": {
        "name": "i2c.events",
        "version": 1
      },
      "event": "I2cEvent",
      "framing": {
        "begin": "begin",
        "items": ["address", "data", "restart"],
        "end": "end",
        "id": "tx",
        "reason": "reason",
        "normal": ["stop", "restart"],
        "partial": "partial"
      }
    }
  ]
}
