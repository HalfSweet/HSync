{
  "ir": 1,
  "name": "onewire",
  "types": [
    {
      "name": "EndReason",
      "type": "enum",
      "variants": ["reset", "bad-slot", "aborted"]
    },
    {
      "name": "OneWireEvent",
      "type": "union",
      "variants": [
        {
          "name": "begin",
          "fields": [
            {
              "name": "tx",
              "type": "u64"
            },
            {
              "name": "presence",
              "type": "bool"
            }
          ]
        },
        {
          "name": "rom-command",
          "fields": [
            {
              "name": "tx",
              "type": "u64"
            },
            {
              "name": "code",
              "type": "u8"
            }
          ]
        },
        {
          "name": "rom",
          "fields": [
            {
              "name": "tx",
              "type": "u64"
            },
            {
              "name": "id",
              "type": "u64",
              "json": "hex-u64"
            },
            {
              "name": "family",
              "type": "u8"
            },
            {
              "name": "crcOk",
              "type": "bool"
            }
          ]
        },
        {
          "name": "search",
          "fields": [
            {
              "name": "tx",
              "type": "u64"
            },
            {
              "name": "id",
              "type": "u64",
              "json": "hex-u64"
            },
            {
              "name": "crcOk",
              "type": "bool"
            },
            {
              "name": "conflicts",
              "type": "u8"
            },
            {
              "name": "unanswered",
              "type": "u8"
            }
          ]
        },
        {
          "name": "byte",
          "fields": [
            {
              "name": "tx",
              "type": "u64"
            },
            {
              "name": "value",
              "type": "u8"
            }
          ]
        },
        {
          "name": "bits",
          "fields": [
            {
              "name": "tx",
              "type": "u64"
            },
            {
              "name": "value",
              "type": "u8"
            },
            {
              "name": "count",
              "type": "u8"
            }
          ]
        },
        {
          "name": "end",
          "fields": [
            {
              "name": "tx",
              "type": "u64"
            },
            {
              "name": "reason",
              "type": "EndReason"
            }
          ]
        }
      ]
    }
  ],
  "contracts": [
    {
      "schema": {
        "name": "onewire.events",
        "version": 1
      },
      "event": "OneWireEvent",
      "roles": {
        "begin": {
          "role": "framing"
        },
        "rom-command": {
          "role": "command"
        },
        "rom": {
          "role": "address",
          "errorWhen": [
            {
              "crcOk": false
            }
          ]
        },
        "search": {
          "role": "address",
          "errorWhen": [
            {
              "crcOk": false
            }
          ]
        },
        "byte": {
          "role": "data"
        },
        "bits": {
          "role": "data"
        },
        "end": {
          "role": "framing"
        }
      }
    }
  ]
}
