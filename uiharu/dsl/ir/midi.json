{
  "ir": 1,
  "name": "midi",
  "types": [
    {
      "name": "ChannelStatus",
      "type": "enum",
      "variants": [
        "note-off",
        "note-on",
        "poly-pressure",
        "control-change",
        "program-change",
        "channel-pressure",
        "pitch-bend"
      ]
    },
    {
      "name": "CommonStatus",
      "type": "enum",
      "variants": [
        "time-code-quarter-frame",
        "song-position-pointer",
        "song-select",
        "tune-request"
      ]
    },
    {
      "name": "RealtimeStatus",
      "type": "enum",
      "variants": ["clock", "start", "continue", "stop", "active-sensing", "reset", "undefined"]
    },
    {
      "name": "EndReason",
      "type": "enum",
      "variants": ["end-of-exclusive", "interrupted", "aborted"]
    },
    {
      "name": "ErrorReason",
      "type": "enum",
      "variants": [
        "unexpected-data",
        "incomplete",
        "aborted",
        "undefined-status",
        "unexpected-end-of-exclusive"
      ]
    },
    {
      "name": "MidiEvent",
      "type": "union",
      "variants": [
        {
          "name": "channel-message",
          "fields": [
            {
              "name": "message",
              "type": "u64"
            },
            {
              "name": "channel",
              "type": "u8"
            },
            {
              "name": "status",
              "type": "ChannelStatus"
            },
            {
              "name": "data1",
              "type": "u8"
            },
            {
              "name": "data2",
              "type": {
                "option": "u8"
              }
            },
            {
              "name": "running",
              "type": "bool"
            }
          ]
        },
        {
          "name": "system-common",
          "fields": [
            {
              "name": "message",
              "type": "u64"
            },
            {
              "name": "status",
              "type": "CommonStatus"
            },
            {
              "name": "data1",
              "type": {
                "option": "u8"
              }
            },
            {
              "name": "data2",
              "type": {
                "option": "u8"
              }
            }
          ]
        },
        {
          "name": "realtime",
          "fields": [
            {
              "name": "status",
              "type": "RealtimeStatus"
            },
            {
              "name": "byte",
              "type": "u8"
            }
          ]
        },
        {
          "name": "sysex",
          "fields": [
            {
              "name": "message",
              "type": "u64"
            },
            {
              "name": "offset",
              "type": "u32"
            },
            {
              "name": "bytes",
              "type": {
                "array": "u8",
                "bound": 32
              }
            }
          ]
        },
        {
          "name": "sysex-end",
          "fields": [
            {
              "name": "message",
              "type": "u64"
            },
            {
              "name": "bytes",
              "type": "u32"
            },
            {
              "name": "reason",
              "type": "EndReason"
            }
          ]
        },
        {
          "name": "error",
          "fields": [
            {
              "name": "reason",
              "type": "ErrorReason"
            },
            {
              "name": "byte",
              "type": "u8"
            }
          ]
        }
      ]
    }
  ],
  "contracts": [
    {
      "schema": {
        "name": "midi.events",
        "version": 1
      },
      "event": "MidiEvent",
      "roles": {
        "channel-message": {
          "role": "data"
        },
        "system-common": {
          "role": "control"
        },
        "realtime": {
          "role": "control"
        },
        "sysex": {
          "role": "data"
        },
        "sysex-end": {
          "role": "framing"
        },
        "error": {
          "role": "error"
        }
      }
    }
  ]
}
