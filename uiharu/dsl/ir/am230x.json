{
  "ir": 1,
  "name": "am230x",
  "types": [
    {
      "name": "ErrorReason",
      "type": "enum",
      "variants": ["start", "response", "bit", "count"]
    },
    {
      "name": "Am230xEvent",
      "type": "union",
      "variants": [
        {
          "name": "reading",
          "fields": [
            {
              "name": "bytes",
              "type": {
                "fixedArray": "u8",
                "length": 5
              }
            },
            {
              "name": "checksumOk",
              "type": "bool"
            },
            {
              "name": "humidityRaw",
              "type": "u16"
            },
            {
              "name": "temperatureRaw",
              "type": "u16"
            }
          ]
        },
        {
          "name": "error",
          "fields": [
            {
              "name": "reason",
              "type": "ErrorReason"
            }
          ]
        }
      ]
    }
  ],
  "contracts": [
    {
      "schema": {
        "name": "am230x.events",
        "version": 1
      },
      "event": "Am230xEvent",
      "roles": {
        "reading": {
          "role": "data",
          "errorWhen": [
            {
              "checksumOk": false
            }
          ]
        },
        "error": {
          "role": "framing"
        }
      }
    }
  ]
}
