{
  "ir": 1,
  "name": "modbus",
  "types": [
    {
      "name": "EndReason",
      "type": "enum",
      "variants": ["complete", "bad-crc", "short", "broken", "aborted"]
    },
    {
      "name": "ModbusEvent",
      "type": "union",
      "variants": [
        {
          "name": "begin",
          "fields": [
            {
              "name": "frame",
              "type": "u64"
            },
            {
              "name": "address",
              "type": "u8"
            },
            {
              "name": "function",
              "type": {
                "option": "u8"
              }
            },
            {
              "name": "exception",
              "type": "bool"
            },
            {
              "name": "partial",
              "type": "bool"
            }
          ]
        },
        {
          "name": "data",
          "fields": [
            {
              "name": "frame",
              "type": "u64"
            },
            {
              "name": "offset",
              "type": "u32"
            },
            {
              "name": "bytes",
              "type": {
                "array": "u8",
                "bound": 32
              }
            }
          ]
        },
        {
          "name": "crc",
          "fields": [
            {
              "name": "frame",
              "type": "u64"
            },
            {
              "name": "value",
              "type": "u16"
            },
            {
              "name": "ok",
              "type": "bool"
            }
          ]
        },
        {
          "name": "end",
          "fields": [
            {
              "name": "frame",
              "type": "u64"
            },
            {
              "name": "reason",
              "type": "EndReason"
            }
          ]
        }
      ]
    }
  ],
  "contracts": [
    {
      "schema": {
        "name": "modbus.events",
        "version": 1
      },
      "event": "ModbusEvent",
      "roles": {
        "begin": {
          "role": "address"
        },
        "data": {
          "role": "data"
        },
        "crc": {
          "role": "check",
          "errorWhen": [
            {
              "ok": false
            }
          ]
        },
        "end": {
          "role": "framing"
        }
      }
    }
  ]
}
