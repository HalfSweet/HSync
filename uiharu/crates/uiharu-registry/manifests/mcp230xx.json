{
  "name": "mcp230xx",
  "category": "device",
  "inputs": [
    {
      "port": "bus",
      "schema": "i2c.events"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "mcp230xx.events"
    }
  ],
  "config": [
    {
      "name": "address",
      "kind": "integer",
      "min": 0,
      "max": 65535
    },
    {
      "name": "model",
      "kind": "enum",
      "values": ["mcp23008", "mcp23017"]
    },
    {
      "name": "initial_bank",
      "kind": "bool"
    },
    {
      "name": "initial_seq_off",
      "kind": "bool"
    }
  ],
  "events": [
    {
      "kind": "begin",
      "role": "address",
      "fields": ["op", "tx", "read", "ack"],
      "errorWhen": [
        {
          "ack": false
        }
      ]
    },
    {
      "kind": "pointer",
      "role": "address",
      "fields": ["op", "register", "ack"]
    },
    {
      "kind": "byte",
      "role": "data",
      "fields": ["op", "register", "value", "read", "ack"]
    },
    {
      "kind": "field",
      "role": "data",
      "fields": ["op", "register", "field", "value", "negative", "valid"],
      "errorWhen": [
        {
          "valid": false
        }
      ]
    },
    {
      "kind": "end",
      "role": "framing",
      "fields": ["op", "reason"]
    }
  ],
  "locales": {
    "en-US": {
      "name": "MCP23008 / MCP23017",
      "summary": "GPIO register banks, masks and observed IOCON changes",
      "fields": {
        "address": "I²C address",
        "initial_bank": "Initial BANK bit",
        "initial_seq_off": "Initial SEQOP bit",
        "model": "Device model"
      },
      "events": {
        "begin": "Address",
        "byte": "Register byte",
        "end": "End",
        "field": "Decoded field",
        "pointer": "Register pointer"
      },
      "eventFields": {
        "ack": "Acknowledged",
        "field": "Field",
        "negative": "Negative",
        "op": "Operation",
        "read": "Read",
        "reason": "Reason",
        "register": "Register",
        "tx": "I²C transaction",
        "valid": "Valid",
        "value": "Value"
      }
    },
    "zh-CN": {
      "name": "MCP23008 / MCP23017",
      "summary": "GPIO 寄存器组、掩码和观测到的 IOCON 配置变化",
      "fields": {
        "address": "I²C 地址",
        "initial_bank": "初始 BANK 位",
        "initial_seq_off": "初始 SEQOP 位",
        "model": "器件型号"
      },
      "events": {
        "begin": "地址",
        "byte": "寄存器字节",
        "end": "结束",
        "field": "解码字段",
        "pointer": "寄存器指针"
      },
      "eventFields": {
        "ack": "应答",
        "field": "字段",
        "negative": "负数",
        "op": "操作号",
        "read": "读取",
        "reason": "原因",
        "register": "寄存器",
        "tx": "I²C 事务",
        "valid": "有效",
        "value": "值"
      }
    }
  }
}
