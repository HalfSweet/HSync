{
  "name": "lin-profile",
  "category": "bus",
  "inputs": [
    {
      "port": "bus",
      "schema": "uart.events"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "lin-profile.events"
    }
  ],
  "config": [
    {
      "name": "baud",
      "kind": "integer",
      "min": 0,
      "max": 4294967295
    },
    {
      "name": "version",
      "kind": "enum",
      "values": ["1", "2"]
    },
    {
      "name": "min_break_bits",
      "kind": "integer",
      "min": 0,
      "max": 255
    },
    {
      "name": "idle_bits",
      "kind": "integer",
      "min": 0,
      "max": 255
    },
    {
      "name": "length_by_id",
      "kind": "bool"
    }
  ],
  "events": [
    {
      "kind": "header",
      "role": "address",
      "fields": ["frame", "pid", "id", "pidOk"]
    },
    {
      "kind": "data",
      "role": "data",
      "fields": ["frame", "offset", "value"]
    },
    {
      "kind": "checksum",
      "role": "check",
      "fields": ["frame", "value", "classicOk", "enhancedOk", "selectedOk"],
      "errorWhen": [
        {
          "selectedOk": false
        }
      ]
    },
    {
      "kind": "error",
      "role": "error",
      "fields": ["frame", "reason"]
    },
    {
      "kind": "end",
      "role": "framing",
      "fields": ["frame", "reason", "idle"]
    }
  ],
  "locales": {
    "en-US": {
      "name": "LIN version and idle profile",
      "summary": "Selected classic/enhanced checksum with explicit idle response completion",
      "fields": {
        "baud": "Baud",
        "idle_bits": "Response idle threshold (bits)",
        "length_by_id": "Use LIN 1.x identifier length",
        "min_break_bits": "Minimum BREAK bits",
        "version": "LIN version"
      },
      "values": {
        "version": {
          "1": "LIN 1.x",
          "2": "LIN 2.x"
        }
      },
      "events": {
        "checksum": "Checksum",
        "data": "Data",
        "end": "End",
        "error": "Protocol error",
        "header": "Header"
      },
      "eventFields": {
        "classicOk": "Classic checksum OK",
        "enhancedOk": "Enhanced checksum OK",
        "frame": "Frame",
        "id": "Identifier",
        "idle": "Ended at idle threshold",
        "offset": "Offset",
        "pid": "Protected identifier",
        "pidOk": "PID parity OK",
        "reason": "Reason",
        "selectedOk": "Selected checksum OK",
        "value": "Value"
      }
    },
    "zh-CN": {
      "name": "LIN版本和空闲格式",
      "summary": "指定经典或增强校验和，并以明确空闲阈值结束响应",
      "fields": {
        "baud": "波特率",
        "idle_bits": "响应空闲阈值（位）",
        "length_by_id": "使用LIN 1.x标识符长度",
        "min_break_bits": "最少BREAK位数",
        "version": "LIN版本"
      },
      "values": {
        "version": {
          "1": "LIN 1.x",
          "2": "LIN 2.x"
        }
      },
      "events": {
        "checksum": "校验和",
        "data": "数据",
        "end": "结束",
        "error": "协议错误",
        "header": "帧头"
      },
      "eventFields": {
        "classicOk": "经典校验和正确",
        "enhancedOk": "增强校验和正确",
        "frame": "帧",
        "id": "标识符",
        "idle": "达到空闲阈值结束",
        "offset": "偏移",
        "pid": "受保护标识符",
        "pidOk": "PID奇偶校验正确",
        "reason": "原因",
        "selectedOk": "指定校验和正确",
        "value": "值"
      }
    }
  }
}
