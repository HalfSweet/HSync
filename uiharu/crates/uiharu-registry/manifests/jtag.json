{
  "name": "jtag",
  "category": "bus",
  "inputs": [
    {
      "port": "logic",
      "schema": "logic.samples"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "jtag.events"
    }
  ],
  "config": [
    {
      "name": "tck",
      "kind": "channel"
    },
    {
      "name": "tms",
      "kind": "channel"
    },
    {
      "name": "tdi",
      "kind": "channel",
      "optional": true
    },
    {
      "name": "tdo",
      "kind": "channel",
      "optional": true
    },
    {
      "name": "trst",
      "kind": "channel",
      "optional": true
    },
    {
      "name": "initial_state",
      "kind": "enum",
      "values": ["unknown", "test-logic-reset", "run-test-idle"]
    }
  ],
  "events": [
    {
      "kind": "state",
      "fields": ["state"]
    },
    {
      "kind": "reset",
      "fields": ["by"]
    },
    {
      "kind": "scan-begin",
      "fields": ["scan", "register"]
    },
    {
      "kind": "shift",
      "fields": ["scan", "offset", "tdi", "tdo", "bits"]
    },
    {
      "kind": "scan-end",
      "fields": ["scan", "bits", "reason"]
    }
  ]
}
