{
  "name": "avr-isp",
  "category": "device",
  "inputs": [
    {
      "port": "bus",
      "schema": "spi.events"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "avrisp.events"
    }
  ],
  "config": [],
  "events": [
    {
      "kind": "instruction",
      "role": "command",
      "fields": ["op", "tx", "command", "address", "dataIn", "dataOut", "inSync", "bytes"],
      "errorWhen": [{ "inSync": false }]
    },
    {
      "kind": "unknown",
      "role": "error",
      "fields": ["tx", "bytes"]
    },
    {
      "kind": "error",
      "role": "error",
      "fields": ["tx", "reason", "bytes"]
    }
  ]
}
