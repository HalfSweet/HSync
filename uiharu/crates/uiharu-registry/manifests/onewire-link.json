{
  "name": "onewire-link",
  "category": "bus",
  "inputs": [
    {
      "port": "logic",
      "schema": "logic.samples"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "onewire.link"
    }
  ],
  "config": [
    {
      "name": "data",
      "kind": "channel"
    },
    {
      "name": "speed",
      "kind": "enum",
      "values": ["standard", "overdrive"]
    }
  ],
  "events": [
    {
      "kind": "reset",
      "role": "line",
      "fields": ["presence"],
      "errorWhen": [{ "presence": false }]
    },
    {
      "kind": "bit",
      "role": "data",
      "fields": ["value"]
    },
    {
      "kind": "bad-slot",
      "role": "error",
      "fields": ["lowTicks"]
    }
  ]
}
