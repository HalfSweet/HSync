{
  "name": "usb",
  "category": "bus",
  "inputs": [
    {
      "port": "logic",
      "schema": "logic.samples"
    }
  ],
  "outputs": [
    {
      "port": "packets",
      "schema": "usb.packets"
    }
  ],
  "config": [
    {
      "name": "dp",
      "kind": "channel"
    },
    {
      "name": "dm",
      "kind": "channel"
    },
    {
      "name": "speed",
      "kind": "enum",
      "values": ["low", "full"]
    }
  ],
  "events": [
    {
      "kind": "begin",
      "fields": ["pkt"]
    },
    {
      "kind": "pid",
      "fields": ["pkt", "pid", "ok"]
    },
    {
      "kind": "token",
      "fields": ["pkt", "address", "endpoint", "crc5", "ok"]
    },
    {
      "kind": "sof",
      "fields": ["pkt", "frame", "crc5", "ok"]
    },
    {
      "kind": "data",
      "fields": ["pkt", "offset", "bytes"]
    },
    {
      "kind": "data-end",
      "fields": ["pkt", "crc16", "ok", "length"]
    },
    {
      "kind": "split",
      "fields": ["pkt", "raw"]
    },
    {
      "kind": "end",
      "fields": ["pkt", "reason"]
    },
    {
      "kind": "reset",
      "fields": ["ticks"]
    },
    {
      "kind": "suspend",
      "fields": []
    },
    {
      "kind": "resume",
      "fields": []
    },
    {
      "kind": "keep-alive",
      "fields": []
    }
  ]
}
