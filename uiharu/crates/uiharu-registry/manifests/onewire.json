{
  "name": "onewire",
  "category": "device",
  "inputs": [
    {
      "port": "link",
      "schema": "onewire.link"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "onewire.events"
    }
  ],
  "config": [],
  "events": [
    {
      "kind": "begin",
      "role": "framing",
      "fields": ["tx", "presence"],
      "errorWhen": [{ "presence": false }]
    },
    {
      "kind": "rom-command",
      "role": "command",
      "fields": ["tx", "code"]
    },
    {
      "kind": "rom",
      "role": "address",
      "fields": ["tx", "id", "family", "crcOk"],
      "errorWhen": [{ "crcOk": false }]
    },
    {
      "kind": "search",
      "role": "address",
      "fields": ["tx", "id", "crcOk", "conflicts", "unanswered"],
      "errorWhen": [{ "crcOk": false }]
    },
    {
      "kind": "byte",
      "role": "data",
      "fields": ["tx", "value"]
    },
    {
      "kind": "bits",
      "role": "data",
      "fields": ["tx", "value", "count"]
    },
    {
      "kind": "end",
      "role": "framing",
      "fields": ["tx", "reason"]
    }
  ]
}
