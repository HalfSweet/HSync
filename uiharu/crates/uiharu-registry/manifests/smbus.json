{
  "name": "smbus",
  "category": "bus",
  "inputs": [
    {
      "port": "bus",
      "schema": "i2c.events"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "smbus.events"
    }
  ],
  "config": [
    {
      "name": "address",
      "kind": "integer",
      "min": 0,
      "max": 65535,
      "optional": true
    },
    {
      "name": "mode",
      "kind": "enum",
      "values": [
        "raw",
        "quick",
        "send-byte",
        "receive-byte",
        "write-byte",
        "write-word",
        "read-byte",
        "read-word",
        "process-call",
        "block-write",
        "block-read",
        "block-process-call",
        "host-notify",
        "write-32",
        "read-32",
        "write-64",
        "read-64"
      ]
    },
    {
      "name": "pec",
      "kind": "bool"
    },
    {
      "name": "max_bytes",
      "kind": "integer",
      "min": 0,
      "max": 65535
    },
    {
      "name": "max_block_bytes",
      "kind": "integer",
      "min": 0,
      "max": 255
    }
  ],
  "events": [
    {
      "kind": "begin",
      "role": "framing",
      "fields": ["tx", "address", "mode", "pec"]
    },
    {
      "kind": "address",
      "role": "address",
      "fields": ["tx", "address", "read", "ack"]
    },
    {
      "kind": "byte",
      "role": "data",
      "fields": ["tx", "read", "index", "value", "ack"]
    },
    {
      "kind": "command",
      "role": "command",
      "fields": ["tx", "value"]
    },
    {
      "kind": "count",
      "role": "control",
      "fields": ["tx", "read", "value", "valid"],
      "errorWhen": [
        {
          "valid": false
        }
      ]
    },
    {
      "kind": "value",
      "role": "data",
      "fields": ["tx", "read", "bytes", "low", "high"]
    },
    {
      "kind": "notify",
      "role": "control",
      "fields": ["tx", "device"]
    },
    {
      "kind": "pec",
      "role": "check",
      "fields": ["tx", "value", "expected", "ok"],
      "errorWhen": [
        {
          "ok": false
        }
      ]
    },
    {
      "kind": "end",
      "role": "framing",
      "fields": ["tx", "mode", "reason", "lengthOk", "valid"],
      "errorWhen": [
        {
          "valid": false
        }
      ]
    }
  ],
  "locales": {
    "en-US": {
      "name": "SMBus transactions",
      "summary": "Explicit byte, word, block and Host Notify profiles with optional PEC",
      "fields": {
        "address": "Target address filter",
        "max_block_bytes": "Maximum block count",
        "max_bytes": "Maximum message bytes",
        "mode": "Transaction profile",
        "pec": "Final PEC byte"
      },
      "values": {
        "mode": {
          "block-process-call": "Block process call",
          "block-read": "Block read",
          "block-write": "Block write",
          "host-notify": "Host Notify",
          "process-call": "Process call",
          "quick": "Quick command",
          "raw": "Raw transaction",
          "read-32": "Read 32 bits",
          "read-64": "Read 64 bits",
          "read-byte": "Read byte",
          "read-word": "Read word",
          "receive-byte": "Receive byte",
          "send-byte": "Send byte",
          "write-32": "Write 32 bits",
          "write-64": "Write 64 bits",
          "write-byte": "Write byte",
          "write-word": "Write word"
        }
      },
      "events": {
        "address": "Address",
        "begin": "Message",
        "byte": "Payload byte",
        "command": "Command",
        "count": "Block count",
        "end": "Message end",
        "notify": "Host Notify",
        "pec": "PEC",
        "value": "Scalar value"
      },
      "eventFields": {
        "ack": "Acknowledged",
        "address": "Address",
        "bytes": "Width in bytes",
        "device": "Notifying address",
        "expected": "Expected PEC",
        "high": "High 32 bits",
        "index": "Byte index",
        "lengthOk": "Length valid",
        "low": "Low 32 bits",
        "mode": "Profile",
        "ok": "PEC valid",
        "pec": "PEC enabled",
        "read": "Read",
        "reason": "End reason",
        "tx": "Transaction",
        "valid": "Transaction valid",
        "value": "Value"
      }
    },
