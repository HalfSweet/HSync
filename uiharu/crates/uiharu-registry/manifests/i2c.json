{
  "name": "i2c",
  "category": "bus",
  "inputs": [
    {
      "port": "logic",
      "schema": "logic.samples"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "i2c.events"
    }
  ],
  "config": [
    {
      "name": "scl",
      "kind": "channel"
    },
    {
      "name": "sda",
      "kind": "channel"
    }
  ],
  "events": [
    {
      "kind": "begin",
      "role": "framing",
      "fields": ["tx", "partial"]
    },
    {
      "kind": "address",
      "role": "address",
      "fields": ["tx", "address", "tenBit", "read", "ack"],
      "errorWhen": [{ "ack": false }]
    },
    {
      "kind": "data",
      "role": "data",
      "fields": ["tx", "byte", "ack"]
    },
    {
      "kind": "restart",
      "role": "framing",
      "fields": ["tx", "droppedBits"]
    },
    {
      "kind": "end",
      "role": "framing",
      "fields": ["tx", "reason", "droppedBits"]
    }
  ]
}
