        "segment_address": "E-DDC段地址"
      },
      "events": {
        "begin": "地址",
        "byte": "寄存器字节",
        "cta-audio": "CTA短音频描述符",
        "cta-block": "CTA数据块",
        "cta-video": "CTA短视频描述符",
        "end": "结束",
        "field": "解码字段",
        "pointer": "寄存器指针",
        "segment": "E-DDC段",
        "timing": "已定义时序"
      },
      "eventFields": {
        "ack": "应答",
