{
  "name": "jtag-stm32",
  "category": "device",
  "inputs": [
    {
      "port": "bus",
      "schema": "jtag.events"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "jtag-stm32.events"
    }
  ],
  "config": [],
  "events": [
    {
      "kind": "reset",
      "role": "framing",
      "fields": []
    },
    {
      "kind": "instruction",
      "role": "command",
      "fields": ["scan", "mcu", "bsc", "captureOk"]
    },
    {
      "kind": "idcode",
      "role": "address",
      "fields": [
        "scan",
        "boundaryScan",
        "value",
        "version",
        "part",
        "manufacturer",
        "lsbOk",
        "density"
      ]
    },
    {
      "kind": "access",
      "role": "data",
      "fields": [
        "scan",
        "ap",
        "read",
        "addr",
        "dataIn",
        "ackBits",
        "responseData",
        "previousScan",
        "accepted"
      ]
    },
    {
      "kind": "abort",
      "role": "command",
      "fields": ["scan", "value", "lowBits"]
    },
    {
      "kind": "bypass",
      "role": "data",
      "fields": ["scan", "mcu", "bsc"]
    },
    {
      "kind": "error",
      "role": "error",
      "fields": ["scan", "bits", "reason"]
    }
  ],
  "locales": {
