{
  "name": "cfp",
  "category": "device",
  "inputs": [
    {
      "port": "bus",
      "schema": "mdio.events"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "cfp.events"
    }
  ],
  "config": [
    {
      "name": "phy",
      "kind": "integer",
      "min": 0,
      "max": 255
    }
  ],
  "events": [
    {
      "kind": "address",
      "role": "address",
      "fields": ["address"]
    },
    {
      "kind": "register",
      "role": "data",
      "fields": ["address", "read", "value", "region"]
    },
    {
      "kind": "identifier",
      "role": "control",
      "fields": ["value", "module"]
    },
    {
      "kind": "error",
      "role": "error",
      "fields": ["reason"]
    }
  ],
  "locales": {
