        "error": "Protocol error",
        "identifier": "Module identifier",
        "register": "Register access"
      },
      "eventFields": {
        "address": "Address",
        "module": "Module type",
        "read": "Read",
        "reason": "Error reason",
        "region": "Register region",
        "value": "Value"
      }
    },
    "zh-CN": {
      "name": "CFP管理",
