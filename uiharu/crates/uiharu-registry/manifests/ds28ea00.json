{
  "name": "ds28ea00",
  "category": "device",
  "inputs": [
    {
      "port": "bus",
      "schema": "onewire.events"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "ds28ea00.events"
    }
  ],
  "config": [],
  "events": [
    {
      "kind": "rom",
      "role": "address",
      "fields": ["id", "crcOk"],
      "errorWhen": [
        {
          "crcOk": false
        }
      ]
    },
    {
      "kind": "command",
      "role": "command",
      "fields": ["code", "command"]
    },
    {
      "kind": "data",
      "role": "data",
      "fields": ["index", "value"]
    },
    {
      "kind": "temperature",
      "role": "data",
      "fields": ["raw", "microCelsius", "negative", "resolution", "crcOk"],
      "errorWhen": [
        {
          "crcOk": false
        }
      ]
    },
    {
      "kind": "pio",
      "role": "data",
      "fields": ["a", "b", "latchA", "latchB", "valid"],
      "errorWhen": [
        {
          "valid": false
        }
      ]
    },
    {
      "kind": "chain",
      "role": "control",
      "fields": ["state", "inverseOk"],
      "errorWhen": [
        {
          "inverseOk": false
        }
      ]
    },
    {
      "kind": "status",
      "role": "control",
      "fields": ["value", "count"]
    },
    {
      "kind": "check",
      "role": "check",
      "fields": ["check", "ok", "value"],
      "errorWhen": [
        {
          "ok": false
        }
      ]
    },
    {
      "kind": "error",
      "role": "error",
      "fields": ["reason"]
    }
  ],
  "locales": {
