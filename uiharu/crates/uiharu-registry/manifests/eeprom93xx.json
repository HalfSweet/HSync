{
  "name": "eeprom93xx",
  "category": "device",
  "inputs": [
    {
      "port": "microwire",
      "schema": "microwire.events"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "eeprom93xx.events"
    }
  ],
  "config": [
    {
      "name": "address_bits",
      "kind": "integer",
      "min": 2,
      "max": 16
    },
    {
      "name": "organisation",
      "kind": "enum",
      "values": ["x16", "x8"]
    }
  ],
  "events": [
    {
      "kind": "instruction",
      "role": "command",
      "fields": ["op", "tx", "command", "address"]
    },
    {
      "kind": "data",
      "role": "data",
      "fields": ["op", "direction", "offset", "values"]
    },
    {
      "kind": "status",
      "role": "handshake",
      "fields": ["op", "tx", "ready"]
    },
    {
      "kind": "end",
      "role": "framing",
      "fields": ["op", "reason"]
    }
  ]
}
