      "role": "data",
      "fields": [
        "tx",
        "code",
        "eoc",
        "dummy",
        "positive",
        "extended",
        "channel",
        "microvolts",
        "negative",
        "valid"
      ]
    },
    {
      "kind": "end",
      "role": "framing",
      "fields": ["tx", "reason"]
    }
  ],
  "locales": {
