{
  "name": "ltc242x",
  "category": "device",
  "inputs": [
    {
      "port": "bus",
      "schema": "spi.events"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "ltc242x.events"
    }
  ],
  "config": [
