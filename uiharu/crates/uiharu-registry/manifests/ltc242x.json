      "name": "model",
      "kind": "enum",
      "values": ["ltc2420", "ltc2421", "ltc2422"]
    },
    {
      "name": "reference_microvolts",
      "kind": "integer",
      "min": 0,
      "max": 4294967295
    }
  ],
  "events": [
    {
      "kind": "begin",
      "role": "framing",
      "fields": ["tx"]
    },
    {
