{
  "name": "max7219",
  "category": "device",
  "inputs": [
    {
      "port": "bus",
      "schema": "spi.events"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "max7219.events"
    }
  ],
  "config": [],
  "events": [
    {
      "kind": "begin",
      "role": "framing",
      "fields": ["tx"]
    },
    {
      "kind": "register",
      "role": "data",
      "fields": ["tx", "slot", "address", "value"]
    },
    {
      "kind": "digit",
      "role": "data",
      "fields": ["tx", "slot", "digit", "segments", "decimalPoint"]
    },
    {
      "kind": "decode-mode",
      "role": "control",
      "fields": ["tx", "slot", "mask"]
    },
    {
      "kind": "intensity",
      "role": "control",
      "fields": ["tx", "slot", "level"]
    },
    {
      "kind": "scan-limit",
      "role": "control",
      "fields": ["tx", "slot", "lastDigit"]
    },
    {
      "kind": "shutdown",
      "role": "control",
      "fields": ["tx", "slot", "enabled"]
    },
    {
      "kind": "display-test",
      "role": "control",
      "fields": ["tx", "slot", "enabled"]
    },
    {
      "kind": "warning",
      "role": "control",
      "fields": ["tx", "slot", "address", "value"]
    },
    {
      "kind": "end",
      "role": "framing",
      "fields": ["tx", "reason"]
    }
  ],
  "locales": {
