{
  "name": "qspi-flash",
  "category": "device",
  "inputs": [
    {
      "port": "logic",
      "schema": "logic.samples"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "qspi-flash.events"
    }
  ],
  "config": [
    {
      "name": "command_mode",
      "kind": "enum",
      "values": ["spi", "qpi"]
    },
    {
      "name": "qpi_dummy_clocks",
      "kind": "integer",
      "min": 0,
      "max": 255
    },
    {
      "name": "dtr_quad_dummy_clocks",
      "kind": "integer",
      "min": 0,
      "max": 255
    },
    {
      "name": "clk",
      "kind": "channel"
    },
    {
      "name": "cs",
      "kind": "channel"
    },
    {
      "name": "io0",
      "kind": "channel"
    },
    {
      "name": "io1",
      "kind": "channel"
    },
    {
      "name": "io2",
      "kind": "channel"
    },
    {
      "name": "io3",
      "kind": "channel"
    },
    {
      "name": "address_bytes",
      "kind": "integer",
      "min": 0,
      "max": 255
    },
    {
      "name": "quad_dummy_clocks",
      "kind": "integer",
      "min": 0,
      "max": 255
    },
    {
      "name": "mode",
      "kind": "integer",
      "min": 0,
      "max": 255
    }
  ],
  "events": [
    {
      "kind": "begin",
      "role": "framing",
      "fields": ["tx", "partial"]
    },
    {
      "kind": "mode-request",
      "role": "control",
      "fields": ["tx", "from", "to", "quadEnable", "followed"]
    },
    {
      "kind": "address-mode",
      "role": "control",
      "fields": ["tx", "bytes", "reset"]
    },
    {
      "kind": "command",
      "role": "command",
      "fields": ["tx", "opcode", "read", "lanes"]
    },
    {
      "kind": "address",
      "role": "address",
      "fields": ["tx", "value", "bits", "lanes"]
    },
    {
      "kind": "mode",
      "role": "data",
      "fields": ["tx", "value"]
    },
    {
      "kind": "dummy",
      "role": "framing",
      "fields": ["tx", "clocks"]
    },
    {
      "kind": "data",
      "role": "data",
      "fields": ["tx", "offset", "value", "read", "lanes"]
    },
    {
      "kind": "sfdp-header",
      "role": "data",
      "fields": ["tx", "signature", "valid", "minor", "major", "parameterHeaders"]
    },
    {
      "kind": "sfdp-parameter",
      "role": "data",
      "fields": ["tx", "index", "id", "minor", "major", "dwords", "pointer"]
    },
    {
      "kind": "density",
      "role": "data",
      "fields": ["tx", "raw", "bits"]
    },
    {
      "kind": "erase",
      "role": "command",
      "fields": ["tx", "address", "bytes"]
    },
    {
      "kind": "status",
      "role": "data",
      "fields": ["tx", "register", "value", "written"]
    },
    {
      "kind": "status-bit",
      "role": "data",
      "fields": ["tx", "field", "value"]
    },
    {
      "kind": "unknown-command",
      "role": "framing",
      "fields": ["tx", "opcode"]
    },
    {
      "kind": "end",
      "role": "framing",
      "fields": ["tx", "reason", "droppedBits"]
    }
  ],
