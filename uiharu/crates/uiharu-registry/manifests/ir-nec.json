{
  "name": "ir-nec",
  "category": "line",
  "inputs": [
    {
      "port": "logic",
      "schema": "logic.samples"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "nec.events"
    }
  ],
  "config": [
    {
      "name": "channel",
      "kind": "channel"
    },
    {
      "name": "polarity",
      "kind": "enum",
      "values": ["active-low", "active-high"]
    },
    {
      "name": "tolerance",
      "kind": "integer",
      "min": 1,
      "max": 50
    }
  ],
  "events": [
    {
      "kind": "frame",
      "role": "data",
      "fields": ["address", "command", "extended", "inverseOk", "raw"],
      "errorWhen": [{ "inverseOk": false }]
    },
    {
      "kind": "repeat",
      "role": "framing",
      "fields": []
    },
    {
      "kind": "error",
      "role": "error",
      "fields": ["reason", "bits", "raw"]
    }
  ]
}
