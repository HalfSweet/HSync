      "fields": ["tx", "register", "read", "bits", "raw", "negative", "magnitude"]
    },
    {
      "kind": "mode",
      "role": "control",
      "fields": [
        "tx",
        "highPassDisabled",
        "lowPassDisabled",
        "cfDisabled",
        "sagDisabled",
        "suspended",
        "temperatureStart",
        "reset",
        "lineCycle",
        "channel1Disabled",
        "channel2Disabled",
        "swap",
        "sampleRate",
        "waveform",
        "positiveOnly"
      ]
    },
    {
      "kind": "gain",
      "role": "control",
      "fields": ["tx", "channel1", "channel2", "inputRange"]
    },
    {
      "kind": "operational-mode",
      "role": "control",
      "fields": ["tx", "highPassDisabled", "lowPassDisabled", "cfDisabled", "disableMode", "reset"]
    },
    {
      "kind": "end",
      "role": "framing",
      "fields": ["tx", "reason"]
    }
  ],
