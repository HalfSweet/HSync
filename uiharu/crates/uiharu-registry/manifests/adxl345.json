{
  "name": "adxl345",
  "category": "device",
  "inputs": [
    {
      "port": "bus",
      "schema": "i2c.events"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "adxl345.events"
    }
  ],
  "config": [
    {
      "name": "address",
      "kind": "integer",
      "min": 0,
      "max": 65535
    }
  ],
  "events": [
    {
      "kind": "begin",
      "role": "address",
      "fields": ["op", "tx", "read", "ack"],
      "errorWhen": [
        {
          "ack": false
        }
      ]
    },
    {
      "kind": "pointer",
      "role": "address",
      "fields": ["op", "register", "ack"]
    },
    {
      "kind": "byte",
      "role": "data",
      "fields": ["op", "register", "value", "read", "ack"]
    },
    {
      "kind": "field",
      "role": "data",
      "fields": ["op", "register", "field", "value", "negative", "valid"],
      "errorWhen": [
        {
          "valid": false
        }
      ]
    },
    {
      "kind": "end",
      "role": "framing",
      "fields": ["op", "reason"]
    }
  ],
  "locales": {
    "en-US": {
      "name": "ADXL345 (I²C)",
      "summary": "Register access and signed raw acceleration axes",
      "fields": {
        "address": "I²C address"
      },
      "events": {
        "begin": "Address",
        "byte": "Register byte",
        "end": "End",
        "field": "Decoded field",
        "pointer": "Register pointer"
      },
      "eventFields": {
        "ack": "Acknowledged",
        "field": "Field",
        "negative": "Negative",
        "op": "Operation",
        "read": "Read",
        "reason": "Reason",
        "register": "Register",
        "tx": "I²C transaction",
        "valid": "Valid",
        "value": "Value"
      }
    },
    "zh-CN": {
      "name": "ADXL345 (I²C)",
      "summary": "寄存器访问和有符号原始加速度轴数据",
      "fields": {
        "address": "I²C 地址"
      },
      "events": {
        "begin": "地址",
        "byte": "寄存器字节",
        "end": "结束",
        "field": "解码字段",
        "pointer": "寄存器指针"
      },
      "eventFields": {
        "ack": "应答",
        "field": "字段",
        "negative": "负数",
        "op": "操作号",
        "read": "读取",
        "reason": "原因",
        "register": "寄存器",
        "tx": "I²C 事务",
        "valid": "有效",
        "value": "值"
      }
    }
  }
}
