{
  "name": "rfm12",
  "category": "device",
  "inputs": [
    {
      "port": "bus",
      "schema": "spi.events"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "rfm12.events"
    }
  ],
  "config": [],
  "events": [
    {
      "kind": "begin",
      "role": "framing",
      "fields": ["tx"]
    },
    {
      "kind": "control",
      "role": "command",
      "fields": ["tx", "command", "status", "opcode"]
    },
    {
      "kind": "command",
      "role": "command",
      "fields": ["tx", "command"]
    },
    {
      "kind": "field",
      "role": "data",
      "fields": ["tx", "field", "value"]
    },
    {
      "kind": "wake-period",
      "role": "data",
      "fields": ["tx", "microseconds"]
    },
    {
      "kind": "end",
      "role": "framing",
      "fields": ["tx", "reason"]
    }
  ],
