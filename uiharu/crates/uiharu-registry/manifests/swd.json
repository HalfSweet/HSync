{
  "name": "swd",
  "category": "bus",
  "inputs": [
    {
      "port": "logic",
      "schema": "logic.samples"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "swd.events"
    }
  ],
  "config": [
    {
      "name": "swclk",
      "kind": "channel"
    },
    {
      "name": "swdio",
      "kind": "channel"
    },
    {
      "name": "turnaround",
      "kind": "integer",
      "min": 1,
      "max": 4
    },
    {
      "name": "overrun_detect",
      "kind": "enum",
      "values": ["auto", "on", "off"]
    }
  ],
  "events": [
    {
      "kind": "begin",
      "role": "framing",
      "fields": ["tx"]
    },
    {
      "kind": "request",
      "role": "command",
      "fields": ["tx", "apndp", "rnw", "addr", "parityOk"],
      "errorWhen": [{ "parityOk": false }]
    },
    {
      "kind": "ack",
      "role": "handshake",
      "fields": ["tx", "value"],
      "errorWhen": [{ "value": "fault" }]
    },
    {
      "kind": "data",
      "role": "data",
      "fields": ["tx", "value", "parityOk", "fromTarget"],
      "errorWhen": [{ "parityOk": false }]
    },
    {
      "kind": "end",
      "role": "framing",
      "fields": ["tx", "reason"]
    },
    {
      "kind": "line-reset",
      "role": "line",
      "fields": []
    },
    {
      "kind": "switch",
      "role": "line",
      "fields": ["to"]
    }
  ]
}
