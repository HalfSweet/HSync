{
  "name": "arm-itm",
  "category": "device",
  "inputs": [
    {
      "port": "bus",
      "schema": "trace-byte.events"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "arm-itm.events"
    }
  ],
  "config": [
    {
      "name": "start_aligned",
      "kind": "bool"
    }
  ],
  "events": [
    {
      "kind": "sync",
      "role": "framing",
      "fields": []
    },
    {
      "kind": "overflow",
      "role": "line",
      "fields": []
    },
    {
      "kind": "software",
      "role": "data",
      "fields": ["port", "page", "bytes", "value"]
    },
    {
      "kind": "hardware",
      "role": "data",
      "fields": ["source", "bytes", "value"]
    },
    {
      "kind": "event-counter",
      "role": "control",
      "fields": ["flags"]
    },
    {
      "kind": "exception",
      "role": "control",
      "fields": ["exception", "action"]
    },
    {
      "kind": "pc",
      "role": "address",
      "fields": ["value"]
    },
    {
      "kind": "sleep",
      "role": "line",
      "fields": []
    },
    {
      "kind": "timestamp",
      "role": "control",
      "fields": ["delta", "control"]
    },
    {
      "kind": "global-low",
      "role": "control",
      "fields": ["fragment", "significantBits", "wrap", "clockChange"]
    },
    {
      "kind": "global-high",
      "role": "control",
      "fields": ["fragment", "timestampBits"]
    },
    {
      "kind": "extension",
      "role": "control",
      "fields": ["hardware", "value"]
    },
    {
      "kind": "error",
      "role": "error",
      "fields": ["header", "reason"]
    }
  ],
  "locales": {
    "en-US": {
      "name": "Arm ITM / DWT",
      "summary": "Unformatted SWO bytes, source packets and local timestamps; synchronize before decoding",
      "fields": {
        "start_aligned": "Assume a packet boundary at the start"
      },
      "events": {
        "error": "Error",
        "event-counter": "Event counter",
        "exception": "Exception",
        "extension": "Extension",
        "global-high": "Global timestamp high fragment",
        "global-low": "Global timestamp low fragment",
        "hardware": "DWT source",
        "overflow": "Overflow",
        "pc": "PC sample",
        "sleep": "Sleep",
        "software": "Instrumentation",
        "sync": "Synchronization",
        "timestamp": "Local timestamp"
      },
      "eventFields": {
        "action": "Exception action",
        "bytes": "Bytes",
        "clockChange": "Clock changed",
        "control": "Timestamp control",
        "delta": "Timestamp delta",
        "exception": "Exception number",
        "flags": "Flags",
        "fragment": "Timestamp fragment",
        "hardware": "Hardware source",
        "header": "Header",
        "page": "Port page",
        "port": "Port",
        "reason": "Reason",
        "significantBits": "Significant low bits",
        "source": "Source",
        "timestampBits": "Timestamp width",
        "value": "Value",
        "wrap": "Upper timestamp changed"
      }
    },
    "zh-CN": {
      "name": "Arm ITM / DWT",
      "summary": "未格式化 SWO 字节、源数据包及局部时间戳；同步后解码",
