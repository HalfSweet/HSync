{
  "name": "usb-transactions",
  "category": "device",
  "inputs": [
    {
      "port": "packets",
      "schema": "usb.packets"
    }
  ],
  "outputs": [
    {
      "port": "transactions",
      "schema": "usb.transactions"
    }
  ],
  "config": [],
  "events": [
    {
      "kind": "begin",
      "role": "address",
      "fields": ["xact", "token", "address", "endpoint", "frame"]
    },
    {
      "kind": "setup",
      "role": "command",
      "fields": ["xact", "bmRequestType", "bRequest", "wValue", "wIndex", "wLength"]
    },
    {
      "kind": "data",
      "role": "data",
      "fields": ["xact", "pid", "offset", "bytes"]
    },
    {
      "kind": "handshake",
      "role": "handshake",
      "fields": ["xact", "pid"],
      "errorWhen": [{ "pid": "stall" }]
    },
    {
      "kind": "end",
      "role": "framing",
      "fields": ["xact", "reason"]
    }
  ]
}
