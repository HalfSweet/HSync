{
  "name": "ps2",
  "category": "bus",
  "inputs": [
    {
      "port": "logic",
      "schema": "logic.samples"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "ps2.events"
    }
  ],
  "config": [
    {
      "name": "clk",
      "kind": "channel"
    },
    {
      "name": "data",
      "kind": "channel"
    }
  ],
  "events": [
    {
      "kind": "frame",
      "role": "data",
      "fields": ["direction", "value", "parityOk", "stopOk", "ack"],
      "errorWhen": [{ "parityOk": false }, { "stopOk": false }]
    },
    {
      "kind": "error",
      "role": "error",
      "fields": ["reason"]
    }
  ]
}
