{
  "name": "modbus-rtu",
  "category": "device",
  "inputs": [
    {
      "port": "uart",
      "schema": "uart.events"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "modbus.events"
    }
  ],
  "config": [],
  "events": [
    {
      "kind": "begin",
      "role": "address",
      "fields": ["frame", "address", "function", "exception", "partial"],
      "errorWhen": [{ "exception": true }]
    },
    {
      "kind": "data",
      "role": "data",
      "fields": ["frame", "offset", "bytes"]
    },
    {
      "kind": "crc",
      "role": "check",
      "fields": ["frame", "value", "ok"],
      "errorWhen": [{ "ok": false }]
    },
    {
      "kind": "end",
      "role": "framing",
      "fields": ["frame", "reason"]
    }
  ]
}
