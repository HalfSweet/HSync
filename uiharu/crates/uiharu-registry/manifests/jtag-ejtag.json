{
  "name": "jtag-ejtag",
  "category": "device",
  "inputs": [
    {
      "port": "bus",
      "schema": "jtag.events"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "jtag-ejtag.events"
    }
  ],
  "config": [
    {
      "name": "ir_bits",
      "kind": "integer",
      "min": 0,
      "max": 255
    }
  ],
  "events": [
    {
      "kind": "reset",
      "role": "framing",
      "fields": []
    },
    {
      "kind": "instruction",
      "role": "control",
      "fields": ["scan", "value", "register", "captureOk"]
    },
    {
      "kind": "register",
      "role": "data",
      "fields": ["scan", "register", "dataIn", "dataOut"]
    },
    {
      "kind": "idcode",
      "role": "address",
      "fields": ["scan", "value", "version", "part", "manufacturer", "lsbOk"]
    },
    {
      "kind": "implementation",
      "role": "control",
      "fields": ["scan", "value", "version"]
    },
    {
      "kind": "control",
      "role": "control",
      "fields": [
        "scan",
        "dataIn",
        "dataOut",
        "pracc",
        "prnw",
        "resetOccurred",
        "debugMode",
        "doze",
        "halt"
      ]
    },
    {
      "kind": "processor-completion-request",
      "role": "control",
      "fields": ["scan", "address", "dataIn", "dataOut", "prnw"]
    },
    {
      "kind": "fastdata",
      "role": "data",
      "fields": ["scan", "completionRequested", "successFlag", "completed", "dataIn", "dataOut"]
    },
    {
      "kind": "bypass",
      "role": "data",
      "fields": ["scan", "dataIn", "dataOut"]
    },
    {
      "kind": "error",
      "role": "error",
      "fields": ["scan", "bits", "reason"]
    }
  ],
  "locales": {
