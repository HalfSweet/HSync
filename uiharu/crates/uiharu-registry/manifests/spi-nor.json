{
  "name": "spi-nor",
  "category": "device",
  "inputs": [
    {
      "port": "bus",
      "schema": "spi.events"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "nor.events"
    }
  ],
  "config": [
    {
      "name": "address_bytes",
      "kind": "enum",
      "values": ["three", "four", "auto"]
    }
  ],
  "events": [
    {
      "kind": "begin",
      "role": "command",
      "fields": ["op", "tx", "command"]
    },
    {
      "kind": "address",
      "role": "address",
      "fields": ["op", "address", "bytes"]
    },
    {
      "kind": "dummy",
      "role": "framing",
      "fields": ["op", "bytes"]
    },
    {
      "kind": "data",
      "role": "data",
      "fields": ["op", "direction", "offset", "bytes"]
    },
    {
      "kind": "status",
      "role": "data",
      "fields": ["op", "register", "value", "written"]
    },
    {
      "kind": "id",
      "role": "data",
      "fields": ["op", "scheme", "bytes"]
    },
    {
      "kind": "end",
      "role": "framing",
      "fields": ["op", "reason"]
    },
    {
      "kind": "unknown-command",
      "role": "error",
      "fields": ["tx", "opcode"]
    }
  ],
  "locales": {
    "en-US": {
      "name": "SPI NOR flash",
      "summary": "Commands a host sends to a serial NOR flash over single-line SPI",
      "fields": {
        "address_bytes": "Address bytes"
      },
      "values": {
        "address_bytes": {
          "auto": "Auto",
          "four": "4 bytes",
          "three": "3 bytes"
        }
      },
      "events": {
        "address": "Address",
        "begin": "Begin",
        "data": "Data",
        "dummy": "Dummy bytes",
        "end": "End",
        "id": "ID",
        "status": "Status register",
        "unknown-command": "Unknown command"
      },
      "eventFields": {
        "address": "Address",
        "bytes": "Bytes",
        "command": "Command",
        "direction": "Direction",
        "offset": "Offset",
        "op": "Operation",
        "opcode": "Opcode",
        "reason": "Reason",
        "register": "Register",
        "scheme": "ID type",
        "tx": "Transaction",
        "value": "Value",
        "written": "Written"
      }
    },
    "zh-CN": {
      "name": "SPI NOR 闪存",
      "summary": "读取主机通过单线 SPI 发给串行 NOR 闪存的命令",
