        "status": "状态寄存器",
        "unknown-command": "未知命令"
      },
      "eventFields": {
        "address": "地址",
        "bytes": "字节",
        "command": "命令",
        "direction": "方向",
        "offset": "偏移",
        "op": "操作号",
        "opcode": "操作码",
        "reason": "原因",
        "register": "寄存器",
