{
  "name": "ps2-device",
  "category": "device",
  "inputs": [
    {
      "port": "bus",
      "schema": "ps2.events"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "ps2-device.events"
    }
  ],
  "config": [
    {
      "name": "mode",
      "kind": "enum",
      "values": [
        "keyboard-set1",
        "keyboard-set2",
        "keyboard-set3",
        "mouse",
        "mouse-wheel",
        "mouse-explorer"
      ]
    }
  ],
  "events": [
    {
      "kind": "key",
      "role": "data",
      "fields": ["code", "extended", "released"]
    },
    {
      "kind": "pause",
      "role": "data",
      "fields": []
    },
    {
      "kind": "print-screen",
      "role": "data",
      "fields": ["released"]
    },
    {
      "kind": "mouse",
      "role": "data",
      "fields": ["buttons", "x", "xNegative", "y", "yNegative", "xOverflow", "yOverflow"]
    },
    {
      "kind": "wheel",
      "role": "data",
      "fields": ["buttons", "magnitude", "negative"]
    },
    {
      "kind": "command",
      "role": "command",
      "fields": ["value", "parameter"]
    },
    {
      "kind": "reply",
      "role": "control",
      "fields": ["command", "index", "value"]
    },
    {
      "kind": "status",
      "role": "line",
      "fields": ["value"]
    },
    {
      "kind": "error",
      "role": "error",
      "fields": ["reason"]
    }
  ],
  "locales": {
    "en-US": {
      "name": "PS/2 keyboard / mouse",
