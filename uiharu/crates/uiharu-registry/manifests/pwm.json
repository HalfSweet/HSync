{
  "name": "pwm",
  "category": "line",
  "inputs": [
    {
      "port": "logic",
      "schema": "logic.samples"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "pwm.events"
    }
  ],
  "config": [
    {
      "name": "channel",
      "kind": "channel"
    },
    {
      "name": "polarity",
      "kind": "enum",
      "values": ["active-high", "active-low"]
    }
  ],
  "events": [
    {
      "kind": "cycle",
      "role": "data",
      "fields": ["periodTicks", "activeTicks"]
    }
  ]
}
