{
  "name": "tlc5620",
  "category": "device",
  "inputs": [
    {
      "port": "logic",
      "schema": "logic.samples"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "tlc5620.events"
    }
  ],
  "config": [
    {
      "name": "clk",
      "kind": "channel"
    },
    {
      "name": "data",
      "kind": "channel"
    },
    {
      "name": "load",
      "kind": "channel",
      "optional": true
    },
    {
      "name": "ldac",
      "kind": "channel",
      "optional": true
    },
    {
      "name": "ldac_low_when_absent",
      "kind": "bool"
    },
    {
      "name": "word_aligned",
      "kind": "bool"
    },
    {
      "name": "vref_a_microvolts",
      "kind": "integer",
      "min": 0,
      "max": 4294967295
    },
    {
      "name": "vref_b_microvolts",
      "kind": "integer",
      "min": 0,
      "max": 4294967295
    },
    {
      "name": "vref_c_microvolts",
      "kind": "integer",
      "min": 0,
      "max": 4294967295
    },
    {
      "name": "vref_d_microvolts",
      "kind": "integer",
      "min": 0,
      "max": 4294967295
    }
  ],
  "events": [
    {
      "kind": "dac",
      "role": "data",
      "fields": ["tx", "channel", "doubleRange", "code", "microvolts", "latched"]
    },
    {
      "kind": "voltage-update",
      "role": "data",
      "fields": ["channel", "microvolts"]
    },
    {
      "kind": "update-all",
      "role": "control",
      "fields": ["knownMask"]
    },
    {
      "kind": "end",
      "role": "framing",
      "fields": ["tx", "reason", "bits"]
    }
  ],
  "locales": {
