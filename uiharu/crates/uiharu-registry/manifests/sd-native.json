{
  "name": "sd-native",
  "category": "bus",
  "inputs": [
    {
      "port": "logic",
      "schema": "logic.samples"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "sd-native.events"
    }
  ],
  "config": [
    {
      "name": "clk",
      "kind": "channel"
    },
    {
      "name": "cmd",
      "kind": "channel"
    },
    {
      "name": "dat0",
      "kind": "channel",
      "optional": true
    },
    {
      "name": "dat1",
      "kind": "channel",
      "optional": true
    },
    {
      "name": "dat2",
      "kind": "channel",
      "optional": true
    },
    {
      "name": "dat3",
      "kind": "channel",
      "optional": true
    },
    {
      "name": "width",
      "kind": "enum",
      "values": ["one", "four", "auto"]
    },
    {
      "name": "block_bytes",
      "kind": "integer",
      "min": 0,
      "max": 65535
    }
  ],
  "events": [
    {
      "kind": "card-status",
      "role": "control",
      "fields": [
        "token",
        "format",
        "value",
        "relativeAddress",
        "currentState",
        "readyForData",
        "appCommand",
        "crcOk",
        "endOk"
      ],
      "errorWhen": [
        {
          "crcOk": false
        },
        {
          "endOk": false
        }
      ]
    },
    {
      "kind": "status-field",
      "role": "control",
      "fields": ["token", "field", "value"]
    },
    {
      "kind": "relative-address",
      "role": "address",
      "fields": ["token", "address", "status", "crcOk", "endOk"],
      "errorWhen": [
        {
          "crcOk": false
        },
        {
          "endOk": false
        }
      ]
    },
    {
      "kind": "interface-condition",
      "role": "control",
      "fields": [
        "token",
        "voltage",
        "voltageRange",
        "pattern",
        "expectedPattern",
        "patternOk",
        "voltageOk",
        "reserved",
        "crcOk",
        "endOk"
      ],
      "errorWhen": [
        {
          "crcOk": false
        },
        {
          "endOk": false
        },
        {
          "patternOk": false
        },
        {
          "voltageOk": false
        }
      ]
    },
    {
      "kind": "ocr",
      "role": "control",
      "fields": ["token", "value", "ready", "highCapacity", "voltageWindow", "endOk"]
    },
    {
      "kind": "scr",
      "role": "data",
      "fields": [
        "block",
        "raw",
        "structure",
        "sdSpec",
        "dataAfterErase",
        "security",
        "busWidths",
        "spec3",
        "extendedSecurity",
        "spec4",
        "specExtension",
        "commandSupport",
        "vendorData",
        "crcOk",
        "supported"
      ],
      "errorWhen": [
        {
          "crcOk": false
        }
      ]
    },
    {
      "kind": "command",
      "role": "command",
      "fields": ["token", "host", "index", "argument", "crc", "crcOk", "endOk"]
    },
    {
      "kind": "cid",
      "role": "data",
      "fields": [
        "token",
        "productName",
        "manufacturer",
        "oem",
        "revision",
        "serial",
        "year",
        "month",
        "crcOk",
        "endOk"
      ]
    },
    {
      "kind": "csd",
      "role": "data",
      "fields": [
        "token",
        "taac",
        "nsac",
        "transferSpeed",
        "commandClasses",
        "readPartial",
        "writeMisalign",
        "readMisalign",
        "dsrImplemented",
        "readCurrentMin",
        "readCurrentMax",
        "writeCurrentMin",
        "writeCurrentMax",
        "sizeMultiplier",
        "eraseSingleBlock",
        "eraseSectorBlocks",
        "writeProtectGroupSectors",
        "writeProtectGroupEnabled",
        "writeSpeedFactor",
        "writeBlockBits",
        "writePartial",
        "fileFormatGroup",
        "copied",
        "permanentWriteProtect",
        "temporaryWriteProtect",
        "fileFormat",
        "registerCrc",
        "structure",
        "size",
        "blocks",
        "readBlockBits",
        "supported",
        "crcOk",
        "endOk"
      ]
    },
    {
      "kind": "data-begin",
      "role": "framing",
      "fields": ["block", "read", "command", "bytes", "lanes"]
    },
    {
      "kind": "data",
      "role": "data",
      "fields": ["block", "offset", "value"]
    },
    {
      "kind": "data-crc",
      "role": "check",
      "fields": ["block", "lane", "value", "expected", "ok"],
      "errorWhen": [
        {
          "ok": false
        }
      ]
    },
    {
      "kind": "data-status",
      "role": "handshake",
      "fields": ["block", "status", "accepted", "endOk"]
    },
    {
      "kind": "busy",
      "role": "handshake",
      "fields": ["block", "ticks"]
    },
    {
      "kind": "data-end",
      "role": "framing",
      "fields": ["block", "reason"]
    },
    {
      "kind": "bus-width",
      "role": "control",
      "fields": ["lanes", "applied"]
    },
    {
      "kind": "aborted-command",
      "role": "framing",
      "fields": ["token", "bits"]
    }
  ],
