{
  "name": "enc28j60",
  "category": "device",
  "inputs": [
    {
      "port": "bus",
      "schema": "spi.events"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "enc28j60.events"
    }
  ],
  "config": [
    {
      "name": "dummy_mode",
      "kind": "enum",
      "values": ["auto", "mac-mii", "ethernet"]
    }
  ],
  "events": [
    {
      "kind": "begin",
      "role": "framing",
      "fields": ["tx"]
    },
    {
      "kind": "command",
      "role": "command",
      "fields": ["tx", "opcode", "address", "read", "status"]
    },
    {
      "kind": "data",
      "role": "data",
      "fields": ["tx", "offset", "address", "value", "read"]
    },
    {
      "kind": "operation",
      "role": "command",
      "fields": ["tx", "operation"]
    },
    {
      "kind": "field",
      "role": "data",
      "fields": ["tx", "address", "field", "value"]
    },
    {
      "kind": "register",
      "role": "command",
      "fields": ["tx", "address", "bank", "name"]
    },
    {
      "kind": "bank",
      "role": "data",
      "fields": ["tx", "bank", "knownMask"]
    },
    {
      "kind": "end",
      "role": "framing",
      "fields": ["tx", "reason"]
    }
  ],
  "locales": {
    "en-US": {
      "name": "ENC28J60",
      "summary": "ENC28J60 bank tracking, named registers, automatic MAC/MII dummy reads and buffers",
      "fields": {
        "dummy_mode": "Register read dummy handling"
      },
      "values": {
        "dummy_mode": {
          "auto": "Follow observed bank",
          "ethernet": "Ethernet (no dummy byte)",
          "mac-mii": "MAC/MII (one dummy byte)"
        }
      },
      "events": {
        "bank": "Bank",
