      },
      "eventFields": {
        "address": "Address",
        "bank": "Bank",
        "field": "Field",
        "knownMask": "Known bank-bit mask",
        "name": "Register name",
        "offset": "Offset",
        "opcode": "Opcode",
        "operation": "Operation",
        "read": "Read",
        "reason": "Reason",
        "status": "Status",
        "tx": "Transaction",
        "value": "Value"
      }
    },
