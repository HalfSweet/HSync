      },
      "events": {
        "reset": "复位",
        "scan-begin": "扫描开始",
        "scan-end": "扫描结束",
        "shift": "移位位",
        "state": "TAP状态"
      },
      "eventFields": {
        "bits": "位数",
        "by": "复位源",
        "offset": "位偏移",
        "reason": "结束原因",
        "register": "寄存器",
        "scan": "扫描",
        "state": "状态",
        "tdi": "TDI位",
        "tdo": "TDO位"
      }
    }
  }
}
