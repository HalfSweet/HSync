{
  "name": "can",
  "category": "bus",
  "inputs": [
    {
      "port": "logic",
      "schema": "logic.samples"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "can.events"
    }
  ],
  "config": [
    {
      "name": "rx",
      "kind": "channel"
    },
    {
      "name": "dominant_low",
      "kind": "bool"
    },
    {
      "name": "bitrate",
      "kind": "integer",
      "min": 1
    },
    {
      "name": "fd_bitrate",
      "kind": "integer",
      "min": 1,
      "optional": true
    },
    {
      "name": "sample_point",
      "kind": "integer",
      "min": 1,
      "max": 99
    },
    {
      "name": "fd",
      "kind": "bool"
    }
  ],
  "events": [
    {
      "kind": "begin",
      "role": "framing",
      "fields": ["frame", "partial"]
    },
    {
      "kind": "id",
      "role": "address",
      "fields": ["frame", "id", "extended"]
    },
    {
      "kind": "control",
      "role": "control",
      "fields": ["frame", "remote", "fd", "brs", "esi", "dlc", "length"]
    },
    {
      "kind": "data",
      "role": "data",
      "fields": ["frame", "offset", "bytes"]
    },
    {
      "kind": "crc",
      "role": "check",
      "fields": ["frame", "value", "ok", "stuffCount"],
      "errorWhen": [{ "ok": false }]
    },
    {
      "kind": "ack",
      "role": "handshake",
      "fields": ["frame", "acked"],
      "errorWhen": [{ "acked": false }]
    },
    {
      "kind": "end",
      "role": "framing",
      "fields": ["frame", "reason"]
    }
  ]
}
