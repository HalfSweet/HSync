{
  "name": "c2",
  "category": "bus",
  "inputs": [
    {
      "port": "logic",
      "schema": "logic.samples"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "c2.events"
    }
  ],
  "config": [
    {
      "name": "clock",
      "kind": "channel"
    },
    {
      "name": "data",
      "kind": "channel"
    },
    {
      "name": "max_wait_cycles",
      "kind": "integer",
      "min": 0,
      "max": 65535
    },
    {
      "name": "start_aligned",
      "kind": "bool"
    }
  ],
  "events": [
    {
      "kind": "reset",
      "role": "control",
      "fields": ["ticks"]
    },
    {
      "kind": "instruction",
      "role": "command",
      "fields": ["op", "command"]
    },
    {
      "kind": "length",
      "role": "control",
      "fields": ["op", "bytes"]
    },
    {
      "kind": "wait",
      "role": "handshake",
      "fields": ["op", "cycles", "ready"]
    },
    {
      "kind": "byte",
      "role": "data",
      "fields": ["op", "index", "value", "address", "read"]
    },
    {
      "kind": "end",
      "role": "framing",
      "fields": ["op", "reason"]
    }
  ],
  "locales": {
    "en-US": {
      "name": "Silicon Labs C2",
      "summary": "C2 reset, address/data frames and bounded variable WAIT",
      "fields": {
        "clock": "C2CK",
        "data": "C2D",
        "max_wait_cycles": "Maximum WAIT cycles",
        "start_aligned": "Start at a known START boundary"
      },
      "events": {
        "byte": "Byte",
        "end": "End",
        "instruction": "Instruction",
        "length": "Data length",
        "reset": "Reset",
        "wait": "WAIT"
      },
      "eventFields": {
        "address": "Address register",
        "bytes": "Byte count",
        "command": "Instruction",
        "cycles": "WAIT cycles",
        "index": "Byte index",
        "op": "Operation",
        "read": "Read",
        "ready": "Ready",
        "reason": "End reason",
        "ticks": "Reset low ticks",
        "value": "Value"
      }
    },
    "zh-CN": {
      "name": "Silicon Labs C2",
      "summary": "C2复位、地址/数据帧及有界等待",
