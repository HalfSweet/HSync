{
  "name": "usb-pd",
  "category": "bus",
  "inputs": [
    {
      "port": "logic",
      "schema": "logic.samples"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "usbpd.events"
    }
  ],
  "config": [
    {
      "name": "cc",
      "kind": "channel"
    },
    {
      "name": "bit_rate",
      "kind": "integer",
      "min": 1
    },
    {
      "name": "tolerance",
      "kind": "integer",
      "min": 0,
      "max": 25
    }
  ],
  "events": [
    {
      "kind": "begin",
      "role": "framing",
      "fields": ["pkt"]
    },
    {
      "kind": "sop",
      "role": "address",
      "fields": ["pkt", "set", "corrupt"],
      "errorWhen": [{ "corrupt": true }]
    },
    {
      "kind": "header",
      "role": "control",
      "fields": [
        "pkt",
        "messageType",
        "control",
        "data",
        "extendedMessage",
        "dataRole",
        "powerRole",
        "cablePlug",
        "revision",
        "messageId",
        "objects",
        "extended"
      ]
    },
    {
      "kind": "extended-header",
      "role": "control",
      "fields": ["pkt", "dataSize", "requestChunk", "chunkNumber", "chunked"]
    },
    {
      "kind": "object",
      "role": "data",
      "fields": ["pkt", "index", "raw"]
    },
    {
      "kind": "pdo",
      "role": "data",
      "fields": [
        "pkt",
        "index",
        "supply",
        "millivolts",
        "milliamps",
        "flags",
        "maxMillivolts",
        "minMillivolts",
        "milliwatts",
        "apdoType"
      ]
    },
    {
      "kind": "rdo",
      "role": "data",
      "fields": [
        "pkt",
        "position",
        "giveBack",
        "capabilityMismatch",
        "usbCommunicationsCapable",
        "noUsbSuspend",
        "unchunkedExtended",
        "operating",
        "maximum"
      ]
    },
    {
      "kind": "data",
      "role": "data",
      "fields": ["pkt", "offset", "bytes"]
    },
    {
      "kind": "crc",
      "role": "check",
      "fields": ["pkt", "value", "ok"],
      "errorWhen": [{ "ok": false }]
    },
    {
      "kind": "hard-reset",
      "role": "line",
      "fields": ["pkt", "corrupt"],
      "errorWhen": [{ "corrupt": true }]
    },
    {
      "kind": "cable-reset",
      "role": "line",
      "fields": ["pkt", "corrupt"],
      "errorWhen": [{ "corrupt": true }]
    },
    {
      "kind": "error",
      "role": "error",
      "fields": ["pkt", "reason"]
    },
    {
      "kind": "end",
      "role": "framing",
      "fields": ["pkt", "reason"]
    }
  ]
}
