{
  "name": "arm-etmv3",
  "category": "device",
  "inputs": [
    {
      "port": "bus",
      "schema": "trace-byte.events"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "arm-etmv3.events"
    }
  ],
  "config": [
    {
      "name": "start_aligned",
      "kind": "bool"
    },
    {
      "name": "context_bytes",
      "kind": "integer",
      "min": 0,
      "max": 255
    },
    {
      "name": "cycle_accurate",
      "kind": "bool"
    },
    {
      "name": "minor_version",
      "kind": "integer",
      "min": 0,
      "max": 255
    },
    {
      "name": "branch_encoding",
      "kind": "enum",
      "values": ["original", "alternative"]
    },
    {
      "name": "data_addresses",
      "kind": "bool"
    },
    {
      "name": "timestamp_bits",
      "kind": "integer",
      "min": 0,
      "max": 255
    }
  ],
  "events": [
    {
      "kind": "sync",
      "role": "framing",
      "fields": []
    },
    {
      "kind": "atom",
      "role": "control",
      "fields": ["atom", "index", "header"]
    },
    {
      "kind": "marker",
      "role": "control",
      "fields": ["marker"]
    },
    {
      "kind": "cycle-count",
      "role": "control",
      "fields": ["value", "overflow"]
    },
    {
      "kind": "isync",
      "role": "address",
      "fields": [
        "address",
        "context",
        "reason",
        "isa",
        "altIsa",
        "nonsecure",
        "hyp",
        "loadStoreInProgress"
      ]
    },
    {
      "kind": "branch",
      "role": "address",
      "fields": [
        "address",
        "fragment",
        "significantBits",
        "isa",
        "exception",
        "legacyException",
        "cancel",
        "resume",
        "nonsecure",
        "hyp",
        "altIsa"
      ]
    },
    {
      "kind": "context",
      "role": "control",
      "fields": ["value"]
    },
    {
      "kind": "vmid",
      "role": "control",
      "fields": ["value"]
    },
    {
      "kind": "data",
      "role": "data",
      "fields": ["tag", "placeholder", "valueTraced", "value", "bytes", "address", "bigEndian"]
    },
    {
      "kind": "timestamp",
      "role": "control",
      "fields": ["fragment", "significantBits", "clockChange"]
    },
    {
      "kind": "error",
      "role": "error",
      "fields": ["header", "reason"]
    }
  ],
  "locales": {
    "en-US": {
      "name": "Arm ETMv3",
      "summary": "ETMv3 packet fields, atoms, observed branch addresses and data",
      "fields": {
        "branch_encoding": "Branch address encoding",
        "context_bytes": "Context ID bytes",
        "cycle_accurate": "Cycle-accurate atom encoding",
        "data_addresses": "Data address tracing enabled",
        "minor_version": "ETMv3 minor version",
        "start_aligned": "Assume packet alignment",
        "timestamp_bits": "Timestamp width"
      },
      "values": {
        "branch_encoding": {
          "alternative": "Alternative encoding",
          "original": "Original encoding"
        }
      },
      "events": {
        "atom": "Instruction atom",
        "branch": "Branch",
        "context": "Context ID",
        "cycle-count": "Cycle count",
        "data": "Data",
        "error": "Error",
        "isync": "Instruction synchronization",
        "marker": "Trace marker",
        "sync": "Alignment synchronization",
        "timestamp": "Timestamp fragment",
        "vmid": "VMID"
      },
      "eventFields": {
        "address": "Observed address",
        "altIsa": "Alternative ISA",
        "atom": "Atom",
        "bigEndian": "BE-8 transfer",
        "bytes": "Value bytes",
        "cancel": "Previous instruction canceled",
        "clockChange": "Clock changed",
        "context": "Context",
        "exception": "Exception",
        "fragment": "Transmitted fragment",
        "header": "Header",
        "hyp": "Hypervisor",
        "index": "Atom index",
        "isa": "Instruction set",
        "legacyException": "Legacy exception encoding",
        "loadStoreInProgress": "Load/store in progress",
        "marker": "Marker",
        "nonsecure": "Non-secure",
        "overflow": "Counter overflow",
