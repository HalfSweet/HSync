{
  "name": "midi-semantics",
  "category": "device",
  "inputs": [
    {
      "port": "bus",
      "schema": "midi.events"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "midi-semantics.events"
    }
  ],
  "config": [
    {
      "name": "percussion_channel",
      "kind": "integer",
      "min": 0,
      "max": 255
    }
  ],
  "events": [
    {
      "kind": "note",
      "role": "data",
      "fields": [
        "message",
        "channel",
        "note",
        "pitchClass",
        "octave",
        "belowZero",
        "action",
        "value",
        "drum"
      ]
    },
    {
      "kind": "controller",
      "role": "control",
      "fields": ["message", "channel", "number", "controller", "lsb", "value"]
    },
    {
      "kind": "pitch-bend",
      "role": "data",
      "fields": ["message", "channel", "value", "magnitude", "negative"]
    },
    {
      "kind": "song-position",
      "role": "control",
      "fields": ["message", "midiBeats", "midiClocks"]
    },
    {
      "kind": "quarter-frame",
      "role": "control",
      "fields": ["message", "piece", "value"]
    },
    {
      "kind": "manufacturer",
      "role": "address",
      "fields": ["message", "identifier", "extended", "manufacturer"]
    }
  ],
  "locales": {
    "en-US": {
      "name": "MIDI semantic fields",
      "summary": "Note, drum and controller names, pitch bend, song position, quarter-frame and SysEx IDs",
      "fields": {
        "percussion_channel": "Percussion channel (zero based)"
      },
      "events": {
        "controller": "Controller",
        "manufacturer": "Manufacturer ID",
        "note": "Note",
        "pitch-bend": "Pitch bend",
        "quarter-frame": "Time code quarter frame",
        "song-position": "Song position"
      },
      "eventFields": {
        "action": "Action",
        "belowZero": "Negative octave",
        "channel": "Channel",
        "controller": "Controller name",
        "drum": "GM percussion",
        "extended": "Extended identifier",
        "identifier": "Identifier",
        "lsb": "LSB controller",
        "magnitude": "Magnitude",
        "manufacturer": "Manufacturer",
        "message": "Message",
        "midiBeats": "MIDI beats",
        "midiClocks": "MIDI clocks",
        "negative": "Negative",
        "note": "Note number",
        "number": "Controller number",
        "octave": "Octave magnitude",
        "piece": "Quarter-frame piece",
        "pitchClass": "Pitch class",
        "value": "Value"
      }
    },
    "zh-CN": {
