{
  "name": "swim-stm8",
  "category": "bus",
  "inputs": [
    {
      "port": "logic",
      "schema": "logic.samples"
    }
  ],
  "outputs": [
    {
      "port": "events",
      "schema": "swim.events"
    }
  ],
  "config": [
    {
      "name": "data",
      "kind": "channel"
    },
    {
      "name": "clock_hz",
      "kind": "integer",
      "min": 0,
      "max": 4294967295
    },
    {
      "name": "speed",
      "kind": "enum",
      "values": ["low", "high"]
    },
    {
      "name": "start_active",
      "kind": "bool"
    },
    {
      "name": "calibrate_sync",
      "kind": "bool"
    }
  ],
  "events": [
    {
      "kind": "command",
      "role": "command",
      "fields": ["value", "parityOk", "ack"]
    },
    {
      "kind": "byte",
      "role": "data",
      "fields": ["direction", "field", "value", "parityOk", "ack", "address"]
    },
    {
      "kind": "reset",
      "role": "framing",
      "fields": []
    },
    {
      "kind": "entry",
      "role": "framing",
      "fields": []
    },
    {
      "kind": "calibration",
      "role": "control",
      "fields": ["clockHz", "lowTicks", "after"]
    },
    {
      "kind": "error",
      "role": "error",
      "fields": ["reason", "partial"]
    }
  ],
  "locales": {
    "en-US": {
      "name": "STM8 SWIM (sync and recovery)",
      "summary": "SWIM packets, command context, observed speed writes and optional synchronization calibration",
      "fields": {
        "calibrate_sync": "Trust the next low pulse as synchronization after entry/reset",
        "clock_hz": "Initial SWIM clock (Hz)",
        "data": "SWIM",
        "speed": "Initial communication speed",
        "start_active": "Start at an active command boundary"
      },
      "values": {
        "speed": {
          "high": "High speed",
          "low": "Low speed"
        }
      },
      "events": {
        "byte": "Byte",
        "calibration": "Synchronization clock estimate",
        "command": "Command",
        "entry": "Entry sequence",
        "error": "Error",
        "reset": "Reset or synchronization"
      },
      "eventFields": {
        "ack": "ACK",
        "address": "Observed address",
        "after": "Following sequence",
        "clockHz": "Estimated clock (Hz)",
        "direction": "Direction",
        "field": "Command position",
        "lowTicks": "Synchronization low ticks",
        "parityOk": "Parity valid",
        "partial": "Partial initial low pulse",
        "reason": "Reason",
        "value": "Value"
      }
    },
    "zh-CN": {
      "name": "STM8 SWIM（同步与恢复）",
